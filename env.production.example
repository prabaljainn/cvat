# CVAT Production Environment Configuration
# Copy this to .env and customize for your deployment

# Domain Configuration
CVAT_HOST=your-domain.com
CVAT_HTTPS=yes

# Database Configuration
CVAT_POSTGRES_HOST=cvat_db
CVAT_POSTGRES_PORT=5432
CVAT_POSTGRES_USER=root
CVAT_POSTGRES_DBNAME=cvat
CVAT_POSTGRES_PASSWORD=your-secure-postgres-password-here

# Redis Configuration
CVAT_REDIS_HOST=cvat_redis
CVAT_REDIS_PORT=6379
CVAT_REDIS_PASSWORD=your-secure-redis-password-here

# Analytics & Custom Features
CVAT_ANALYTICS_ENABLED=true
CVAT_CUSTOM_FEATURES_ENABLED=true
ANGULAR_DASHBOARD_ENABLED=true

# SSL Configuration (Let's Encrypt)
ACME_EMAIL=your-email@your-domain.com
TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_EMAIL=your-email@your-domain.com

# Security Configuration
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
ALLOWED_HOSTS=your-domain.com,localhost,127.0.0.1

# CORS Configuration for Dashboard Integration
CORS_ORIGIN_WHITELIST=https://your-domain.com,http://your-domain.com
CORS_ALLOW_CREDENTIALS=true

# Email Configuration (Optional)
EMAIL_HOST=smtp.your-domain.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@your-domain.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_USE_TLS=true

# Backup Configuration (Optional)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# Monitoring Configuration (Optional)
SENTRY_DSN=your-sentry-dsn-here
LOG_LEVEL=INFO

# Performance Configuration
CVAT_SHARE_URL=
CVAT_ANALYTICS_CHECK_JOB_DELAY=5
CVAT_ANALYTICS_CHECK_JOB_TIMEOUT=3600
